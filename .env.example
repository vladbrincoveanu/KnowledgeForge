# KnowledgeForge Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials

# Database Passwords
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://knowledgeforge:your_secure_postgres_password_here@postgres:5432/knowledgeforge

# Neo4j Password
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_AUTH=neo4j/your_secure_neo4j_password_here

# OpenAI API Key (optional - leave empty to use local LM Studio)
# Used for: LLM enrichment, system descriptions, dependency classification (business vs technical)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# LM Studio Configuration (used if OPENAI_API_KEY is not set)
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL_NAME=llama2
LMSTUDIO_MODEL=llama2

# LLM provider selection: auto | lmstudio | openai
KF_LLM_PROVIDER=auto

# Service extraction LLM enrichment
KF_ENABLE_LLM_LABELS=true

# GitHub API Token (optional - for higher rate limits on org scanning)
# Without token: 60 requests/hour | With token: 5000 requests/hour
# Generate at: https://github.com/settings/tokens (public_repo scope)
GITHUB_TOKEN=
