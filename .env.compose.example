# Optional: override host ports to avoid conflicts with other apps on the same machine.
# Keep the container-side ports unchanged; only change the left side.

# Postgres
POSTGRES_HOST_PORT=5433

# Neo4j
NEO4J_HTTP_HOST_PORT=7475
NEO4J_BOLT_HOST_PORT=7688

# API/UI
API_HOST_PORT=8001
UI_HOST_PORT=3001

# Portainer
PORTAINER_HOST_PORT=9003
