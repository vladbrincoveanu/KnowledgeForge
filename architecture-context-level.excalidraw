      "text": "system_name        ← package.json / README\npurpose            ← README first paragraph\nbusiness_domain    ← service name + keyword scan\nowner_team         ← CODEOWNERS / README\ncriticality        ← Tier 1/2/3  (name heuristics)\ndata_class         ← PII / Credit-Card / General\nlifecycle_status   ← git commit frequency thresholds\nactive_experts     ← git shortlog  ≥1 commit / 90d\ncommit_count_90d   ← git log  --since=90d --oneline\ndoc_quality        ← README depth + OpenAPI + ADRs",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "baseline": 12,
      "containerId": null,
      "originalText": "system_name        ← package.json / README\npurpose            ← README first paragraph\nbusiness_domain    ← service name + keyword scan\nowner_team         ← CODEOWNERS / README\ncriticality        ← Tier 1/2/3  (name heuristics)\ndata_class         ← PII / Credit-Card / General\nlifecycle_status   ← git commit frequency thresholds\nactive_experts     ← git shortlog  ≥1 commit / 90d\ncommit_count_90d   ← git log  --since=90d --oneline\ndoc_quality        ← README depth + OpenAPI + ADRs",
      "lineHeight": 1.4
    },

