{
  "database": {
    "mongodb": {
      "connection_string": "mongodb://username:password@localhost:27017/?authSource=admin",
      "database_name": "knowlly_data",
      "max_pool_size": 10,
      "min_pool_size": 1
    }
  },
  "cache": {
    "redis": {
      "connection_string": "redis://localhost:6379",
      "max_connections": 20,
      "timeout": 30
    }
  },
  "storage": {
    "minio": {
      "endpoint": "localhost:9000",
      "access_key": "your_access_key",
      "secret_key": "your_secret_key",
      "bucket_name": "knowlly-files",
      "use_ssl": false
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false,
    "cors_origins": ["*"],
    "rate_limit": {
      "requests_per_minute": 100,
      "burst_size": 20
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/knowlly.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "security": {
    "jwt_secret": "your_jwt_secret_key_here",
    "jwt_expiration": 3600,
    "bcrypt_rounds": 12,
    "session_timeout": 1800
  },
  "processing": {
    "max_file_size": "100MB",
    "allowed_extensions": [".csv", ".xlsx", ".xls"],
    "batch_size": 1000,
    "timeout": 300
  },
  "monitoring": {
    "enabled": true,
    "metrics_port": 9090,
    "health_check_interval": 30
  },
  "development": {
    "auto_reload": true,
    "log_queries": false,
    "mock_external_services": false
  }
} 